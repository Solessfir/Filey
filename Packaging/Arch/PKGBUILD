# Builds Filey from the latest commit.
# Local use: makepkg -si in this folder.
# Publishing to the AUR also needs a .SRCINFO: makepkg --printsrcinfo > .SRCINFO

# Maintainer: Solessfir
pkgname=filey-git
pkgver=r0
pkgrel=1
pkgdesc="A fast file manager"
arch=(x86_64)
url="https://github.com/Solessfir/Filey"
license=(MIT)
depends=(wayland libxkbcommon libglvnd freetype2 fontconfig)
makedepends=(git clang pkgconf)
provides=(filey)
conflicts=(filey)
source=("filey::git+$url.git")
sha256sums=(SKIP)

pkgver() {
    cd filey
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd filey
    ./Build.sh release
}

package() {
    cd filey
    install -Dm755 Bin/release/filey "$pkgdir/usr/bin/filey"
    install -Dm644 Source/Resources/filey.desktop "$pkgdir/usr/share/applications/filey.desktop"
    install -Dm644 Source/Resources/Filey.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/filey.svg"
    for png in Source/Resources/Icons/filey-*.png; do
        size=${png##*-}
        size=${size%.png}
        install -Dm644 "$png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/filey.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
